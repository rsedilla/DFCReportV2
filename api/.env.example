# API configuration.
#
# Copy to api/.env and fill in. Values are never committed (CLAUDE.md, Secrets).
# The application refuses to start on a missing or implausible value rather than
# falling back to a default that would be wrong in production.

NODE_ENV=
PORT=

# postgresql://user:password@host:5432/database
DATABASE_URL=

# At least 32 characters, from a cryptographically secure source.
JWT_SECRET=

# Comma-separated browser origins. Empty permits none, which is correct for an
# API whose other two clients are phones.
CORS_ALLOWED_ORIGINS=

# The two Senior Pastors SKILL.md section 4 names, by Person id, comma-separated.
#
# Read from here and never from the database, so that who holds the role does not
# depend on a row somebody could edit (SKILL.md section 7). Not a secret — it is
# two identifiers — but it decides authority, so treat a change to it as one.
#
# Empty until the initial import has created them. While it is empty no
# SENIOR_PASTOR account can be provisioned and an existing role row grants
# nothing, which is correct before the import and wrong afterwards. A malformed
# value stops the process rather than failing quietly.
SENIOR_PASTOR_PERSON_IDS=
